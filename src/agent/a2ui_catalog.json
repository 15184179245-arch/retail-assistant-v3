{
  "catalogId": "retaildemo-catalog-v1",
  "protocolVersion": "v0.9.1",
  "updated": "2026-09-21",
  "comment": "老王生成式 UI 组件目录（单一真源）。给三处用：① src/agent/a2ui.py 出网前校验；② scripts/gen_a2ui_llm_instructions.py 生成喂 hermes 的说明书；③ APP 渲染层白名单（由 test_a2ui.py 的跨语言一致性用例锁住，不许漂移）。样式属性一律不在本目录内 —— 外观只从 design/tokens.json 与 M14 画布取。",
  "geometry": "design/A2UI-CATALOG.md",
  "dataBinding": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "unevaluatedProperties": false
  },
  "action": {
    "type": "object",
    "properties": {
      "name": {
        "enum": [
          "navigate"
        ],
        "comment": "只允许导航；confirm/exec 等写语义不在目录内，写操作只能走 pending_actions 票据"
      },
      "context": {
        "type": "object"
      }
    },
    "required": [
      "name",
      "context"
    ],
    "unevaluatedProperties": false
  },
  "routes": {
